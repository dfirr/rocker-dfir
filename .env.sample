# CRAN package list file (one per line)
# R_PACKAGES_FILE=./r_packages.txt
R_PACKAGES_FILE=./r_packages.txt

# GitHub package list file (one per line, owner/repo)
# GH_PACKAGES_FILE=./gh_packages.txt
GH_PACKAGES_FILE=./gh_packages.txt

# RStudio Server password for user 'rstudio'
# PASSWORD=your_password
PASSWORD=

# Host path to cases directory
# CASES_DIR=${HOME}/cases
CASES_DIR=${HOME}/cases

# Host path to RStudio config dir
# RSTUDIO_CONFIG_DIR=./rstudio_config
RSTUDIO_CONFIG_DIR=./rstudio_config

# Host path to rserver.conf
# RSTUDIO_RSERVER_CONF=./rstudio_etc/rserver.conf
RSTUDIO_RSERVER_CONF=./rstudio_etc/rserver.conf

# Corporate CA directory (place .crt files here)
# CORP_CA_DIR=./corp_ca
CORP_CA_DIR=./corp_ca

# MSTICPy config file (Splunk, etc.)
# MSTICPY_CONFIG_FILE=./msticpy_config/msticpyconfig.yaml
MSTICPY_CONFIG_FILE=./msticpy_config/msticpyconfig.yaml
