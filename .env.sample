# Multi-user mode environment sample.
# For single-user mode, copy .env.single.sample to .env instead.

# CRAN package list file (one per line)
# R_PACKAGES_FILE=./r_packages.txt
R_PACKAGES_FILE=./r_packages.txt

# GitHub package list file (one per line, owner/repo)
# GH_PACKAGES_FILE=./gh_packages.txt
GH_PACKAGES_FILE=./gh_packages.txt

# RStudio system users file
# RSTUDIO_USERS_FILE=./rstudio_users/users.conf
# See rstudio_users/users.conf.sample for the expected format.
RSTUDIO_USERS_FILE=./rstudio_users/users.conf

# Internal fallback/service account UID/GID for the image's built-in `rstudio` user.
# Keep these below 1000 so host-aligned users can use 1000+ without colliding.
# RSTUDIO_BASE_UID=999
RSTUDIO_BASE_UID=999
# RSTUDIO_BASE_GID=999
RSTUDIO_BASE_GID=999

# Persistent home root for RStudio users
# RSTUDIO_HOME_ROOT=./rstudio_home
RSTUDIO_HOME_ROOT=./rstudio_home

# Host path to per-user cases root
# CASES_ROOT_DIR=${HOME}/cases
CASES_ROOT_DIR=${HOME}/cases

# Host path to shared cases root
# SHARED_CASES_DIR=${HOME}/shared_cases
SHARED_CASES_DIR=${HOME}/shared_cases

# Fixed GID for the shared writable group inside the container.
# Set this to a stable value if you want predictable host-side group ownership.
# SHARED_CASES_GROUP_GID=2000
SHARED_CASES_GROUP_GID=

# Host path to RStudio skeleton config dir
# RSTUDIO_CONFIG_DIR=./rstudio_config
RSTUDIO_CONFIG_DIR=./rstudio_config

# Host path to rserver.conf
# RSTUDIO_RSERVER_CONF=./rstudio_etc/rserver.conf
RSTUDIO_RSERVER_CONF=./rstudio_etc/rserver.conf

# MSTICPy skeleton config dir (sample or shared defaults)
# MSTICPY_CONFIG_DIR=./msticpy_config
MSTICPY_CONFIG_DIR=./msticpy_config
